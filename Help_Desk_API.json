            }
          }
        },
        {
          "name": "Get Comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}/comments"
          }
        }
      ]
    }
