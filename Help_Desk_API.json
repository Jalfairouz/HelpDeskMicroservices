              },
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"يبدو أن المشكلة من الهارد ديسك\"\n}"
            }
          }
        },
        {
          "name": "Add Comment (Technician)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
