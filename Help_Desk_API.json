{
  "info": {
    "name": "Help Desk API-2",
    "description": "Order: 1) Admin Login  2) Register employee + Login  3) Create technician + Login  4) Tickets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register (Employee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userApi}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@example.com\",\n  \"password\": \"Password123\",\n  \"firstName\": \"أحمد\",\n  \"lastName\": \"محمد\"\n}"
            }
          }
        },
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userApi}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@helpdesk.com\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('adminToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userApi}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('employeeToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Technician",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userApi}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('technicianToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{userApi}}/api/users/me"
          }
        },
        {
          "name": "Create User (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{userApi}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech@example.com\",\n  \"password\": \"Password123\",\n  \"firstName\": \"خالد\",\n  \"lastName\": \"علي\",\n  \"role\": \"Technician\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('userId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{userApi}}/api/users"
          }
        },
        {
          "name": "Get User by ID (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{userApi}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Update User (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{userApi}}/api/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech.updated@example.com\",\n  \"firstName\": \"خالد\",\n  \"lastName\": \"سعد\"\n}"
            }
          }
        },
        {
          "name": "Change User Role (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{userApi}}/api/users/{{userId}}/role",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Technician\"\n}"
            }
          }
        },
        {
          "name": "Change Active Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{userApi}}/api/users/{{userId}}/active-status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Delete User - Soft (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{userApi}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "3. Internal",
      "item": [
        {
          "name": "Get Active Technicians",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": "{{userApi}}/api/internal/users/technicians"
          }
        }
      ]
    },
    {
      "name": "4. Tickets",
      "item": [
        {
          "name": "Create Ticket (Employee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"مشكلة في الكمبيوتر\",\n  \"description\": \"الجهاز بطيء جداً\",\n  \"type\": \"Incident\",\n  \"category\": \"Hardware\",\n  \"priority\": \"High\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('ticketId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Tickets (Employee)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets"
          }
        },
        {
          "name": "Get Assigned Tickets (Technician)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets"
          }
        },
        {
          "name": "Get All Tickets (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets"
          }
        },
        {
          "name": "Get Ticket by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Update Ticket (Technician)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"عنوان جديد\",\n  \"description\": \"وصف جديد\",\n  \"type\": \"Incident\",\n  \"category\": \"Software\",\n  \"priority\": \"Medium\"\n}"
            }
          }
        },
        {
          "name": "Assign Ticket (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}/assign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": \"{{userId}}\"\n}"
            }
          }
        },
        {
          "name": "Auto Assign Ticket (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}/auto-assign"
          }
        },
        {
          "name": "Start Work - InProgress (Technician)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"InProgress\"\n}"
            }
          }
        },
        {
          "name": "Close Ticket (Technician)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Closed\"\n}"
            }
          }
        },
        {
          "name": "Get Ticket History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}/history"
          }
        },
        {
          "name": "Delete Ticket (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{ticketApi}}/api/tickets/{{ticketId}}"
          }
        }
      ]
    },
